# ---- Postgres ----
POSTGRES_USER=ddecor
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=ddecor_id_studio

# ---- App ----
APP_PORT=4000
# Stable secret that signs session tokens. Generate one:  openssl rand -hex 48
SESSION_SECRET=replace-with-a-long-random-hex-string

# ---- Platform-owner superadmin (seeded ONCE, then hidden) ----
# After the first successful boot the account lives in Postgres.
# You may delete these two lines afterwards; the account persists until `docker compose down -v`.
SUPERADMIN_EMAIL=admin@ddecor.com
SUPERADMIN_PASSWORD=change-Me!
